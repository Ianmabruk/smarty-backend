# ---------------------------------------------------------------------------
# Core application secrets (server side only - never exposed to the frontend)
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production-jwt
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=86400

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# In production this must point at the existing database, for example:
#   postgres://user:password@host:5432/educcore
# The API refuses to start in production when DATABASE_URL is missing.
DATABASE_URL=sqlite:///instance/educcore.db
AUTO_CREATE_TABLES=True
RESET_STALE_SQLITE_DB=False

DEBUG=True
HOST=0.0.0.0
PORT=5000

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma separated list of allowed browser origins. Use the exact Netlify
# origin of the deployed frontend, for example:
#   https://my-site.netlify.app
# A wildcard such as https://*.netlify.app is expanded into a matching regex.
CORS_ORIGINS=http://localhost:19006,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_SUPPORTS_CREDENTIALS=True
CORS_MAX_AGE_SECONDS=600

# ---------------------------------------------------------------------------
# Reverse proxy / TLS (Render terminates TLS and sets X-Forwarded-Proto)
# ---------------------------------------------------------------------------
TRUST_PROXY=True

# ---------------------------------------------------------------------------
# Authentication rate limiting (failed sign-ins only)
# ---------------------------------------------------------------------------
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_REGISTER_RATE_LIMIT_ATTEMPTS=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# ---------------------------------------------------------------------------
# Live-data API providers for the AI assistant (server-side only)
# ---------------------------------------------------------------------------
OPENWEATHER_API_KEY=
GNEWS_API_KEY=
NEWSAPI_KEY=
GUARDIAN_API_KEY=
WIKIPEDIA_API_KEY=
OPENLIBRARY_API_KEY=
SERPER_API_KEY=
SERPER_API_URL=https://google.serper.dev

# ---------------------------------------------------------------------------
# AI provider (server-side only). The default provider is the Ollama service.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
AI_API_KEY=
AI_API_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5:7b

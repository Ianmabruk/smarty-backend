# The deployed API origin of the Flask backend on Render.
#
# The value is normalised at build time: it always ends in exactly one `/api`
# segment, so both of these work and neither produces `/api/api`:
#   VITE_API_BASE_URL=https://your-render-service.onrender.com
#   VITE_API_BASE_URL=https://your-render-service.onrender.com/api
#
# For local development point this at the local Flask server:
#   VITE_API_BASE_URL=http://127.0.0.1:5000/api
#
# NOTE: changing this variable requires a new Netlify build/redeploy.
VITE_API_BASE_URL=https://your-render-service.onrender.com/api

# Optional: request timeout in milliseconds (default 20000).
# VITE_API_TIMEOUT_MS=20000

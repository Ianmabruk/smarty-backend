{
  "name": "Educore",
  "slug": "educcore",
  "version": "1.0.0",
  "orientation": "portrait",
  "userInterfaceStyle": "light",
  "platforms": [
    "ios",
    "android",
    "web"
  ],
  "web": {
    "bundler": "metro",
    "output": "single",
    "favicon": ""
  },
  "assetBundlePatterns": [
    "**/*"
  ],
  "ios": {
    "supportsTablet": true
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#FFFFFF"
    }
  },
  "plugins": [
    "expo-secure-store",
    "expo-status-bar",
    "expo-font"
  ]
}
